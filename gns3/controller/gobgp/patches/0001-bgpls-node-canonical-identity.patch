+package table
+
+import (
+	"bytes"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/osrg/gobgp/v3/pkg/packet/bgp"
+)
+
+func ospfAreaNodeForTest(t *testing.T, area uint32) *bgp.LsAddrPrefix {
+	t.Helper()
+	descriptor := bgp.NewLsTLVNodeDescriptor(&bgp.LsNodeDescriptor{
+		Asn: 65000, BGPLsID: 0, OspfAreaID: area,
+		IGPRouterID: string([]byte{192, 0, 2, 1}),
+	}, bgp.LS_TLV_LOCAL_NODE_DESC)
+	node := &bgp.LsAddrPrefix{
+		Type: bgp.LS_NLRI_TYPE_NODE,
+		NLRI: &bgp.LsNodeNLRI{
+			LsNLRI:        bgp.LsNLRI{NLRIType: bgp.LS_NLRI_TYPE_NODE, ProtocolID: bgp.LS_PROTOCOL_OSPF_V2, Identifier: 0},
+			LocalNodeDesc: &descriptor,
+		},
+	}
+	wire, err := node.Serialize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded := &bgp.LsAddrPrefix{}
+	if err := decoded.DecodeFromBytes(wire); err != nil {
+		t.Fatal(err)
+	}
+	return decoded
+}
+
+func TestLsNodeAreasSurviveIndependentWithdrawal(t *testing.T) {
+	tbl := NewTable(logger, bgp.RF_LS)
+	peer := &PeerInfo{AS: 65000, LocalAS: 65000, ID: net.ParseIP("192.0.2.2"), Address: net.ParseIP("192.0.2.2")}
+	attrs := []bgp.PathAttributeInterface{
+		bgp.NewPathAttributeOrigin(bgp.BGP_ORIGIN_ATTR_TYPE_IGP),
+		bgp.NewPathAttributeAsPath([]bgp.AsPathParamInterface{}),
+	}
+	area0, area1 := ospfAreaNodeForTest(t, 0), ospfAreaNodeForTest(t, 1)
+	path0 := NewPath(peer, area0, false, attrs, time.Now(), false)
+	path1 := NewPath(peer, area1, false, attrs, time.Now(), false)
+	tbl.update(path0)
+	tbl.update(path1)
+	if got := len(tbl.GetDestinations()); got != 2 {
+		t.Fatalf("same OSPF router in two areas must retain two RIB destinations; got %d", got)
+	}
+	if tbl.GetDestination(area0) == tbl.GetDestination(area1) {
+		t.Fatal("area nodes share a RIB destination")
+	}
+	// A same-source re-advertisement replaces only the matching area's path.
+	tbl.update(NewPath(peer, ospfAreaNodeForTest(t, 0), false, attrs, time.Now(), false))
+	if len(tbl.GetDestinations()) != 2 || len(tbl.GetDestination(area0).knownPathList) != 1 || len(tbl.GetDestination(area1).knownPathList) != 1 {
+		t.Fatal("same-area replacement changed the other area or retained duplicate paths")
+	}
+	// Decode a fresh, byte-identical NLRI as a real received withdrawal would.
+	withdraw := ospfAreaNodeForTest(t, 0)
+	want, _ := area0.Serialize()
+	got, _ := withdraw.Serialize()
+	if !bytes.Equal(want, got) {
+		t.Fatal("withdrawal fixture differs from original NLRI")
+	}
+	tbl.update(NewPath(peer, withdraw, true, nil, time.Now(), false))
+	// The internal table may retain an empty destination while its local path
+	// ID remains allocated. Select is the live RIB view used by ListPath.
+	selected, err := tbl.Select()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(selected.GetDestinations()) != 1 || selected.GetDestination(area0) != nil {
+		t.Fatal("withdrawn area remains in the RIB")
+	}
+	remaining := selected.GetDestination(area1)
+	if remaining == nil || len(remaining.knownPathList) != 1 || remaining.knownPathList[0] != path1 {
+		t.Fatal("withdrawing area zero removed or replaced the area-one path")
+	}
+}
