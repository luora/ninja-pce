+package bgp
+
+import (
+	"bytes"
+	"encoding/binary"
+	"strings"
+	"testing"
+)
+
+func malformedNodeUpdateForIdentityTest(t *testing.T, protocol LsProtocolID, instance uint64, descriptors string, trailing int) *LsAddrPrefix {
+	t.Helper()
+	node := nodeIdentityTestPrefix(t, protocol, instance, descriptors)
+	wire, err := node.Serialize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire = append(wire, bytes.Repeat([]byte{0x2a}, trailing)...)
+	binary.BigEndian.PutUint16(wire[2:4], uint16(len(wire)-4))
+	binary.BigEndian.PutUint16(wire[15:17], uint16(len(wire)-17))
+	// Construct received bytes directly: serializing the malformed fixture
+	// through GoBGP would fail before its incoming decoder can be exercised.
+	mp := append([]byte{0x40, 0x04, 0x47, 4, 192, 0, 2, 2, 0}, wire...)
+	attrs := append([]byte{0x40, 1, 1, 0, 0x40, 2, 0, 0x80, 14, byte(len(mp))}, mp...)
+	body := append([]byte{0, 0, 0, 0}, attrs...)
+	binary.BigEndian.PutUint16(body[2:4], uint16(len(attrs)))
+	message := bytes.Repeat([]byte{0xff}, 19)
+	message[18] = BGP_MSG_UPDATE
+	binary.BigEndian.PutUint16(message[16:18], uint16(len(message)+len(body)))
+	message = append(message, body...)
+	decoded, err := ParseBGPMessage(message)
+	if err != nil {
+		t.Fatal(err)
+	}
+	update := decoded.Body.(*BGPUpdate)
+	if ok, err := ValidateUpdateMsg(update, map[RouteFamily]BGPAddPathMode{RF_LS: BGP_ADD_PATH_NONE}, false, false, false); !ok {
+		t.Fatalf("upstream validator unexpectedly rejected fixture: %v", err)
+	}
+	prefix := update.PathAttributes[2].(*PathAttributeMpReachNLRI).Value[0].(*LsAddrPrefix)
+	if _, err := prefix.Serialize(); err == nil {
+		t.Fatal("malformed descriptor must reach the serialization-error fallback")
+	}
+	return prefix
+}
+
+func TestLsNodeMalformedCanonicalIdentity(t *testing.T) {
+	const igp = "020000040000fde80201000400000000"
+	const area0 = "0202000400000000"
+	const area1 = "0202000400000001"
+	const router = "02030004c0000201"
+	tests := []struct {
+		name        string
+		protocol    LsProtocolID
+		instance    uint64
+		descriptors string
+	}{
+		{"area-zero", LS_PROTOCOL_OSPF_V2, 0, igp + area0 + router},
+		{"area-one", LS_PROTOCOL_OSPF_V2, 0, igp + area1 + router},
+		{"area-absent", LS_PROTOCOL_OSPF_V2, 0, igp + router},
+		{"ls-id-absent", LS_PROTOCOL_OSPF_V2, 0, "020000040000fde8" + area0 + router},
+		{"router-two", LS_PROTOCOL_OSPF_V2, 0, igp + area0 + "02030004c0000202"},
+		{"instance", LS_PROTOCOL_OSPF_V2, 1, igp + area0 + router},
+		{"protocol", LS_PROTOCOL_OSPF_V3, 0, igp + area0 + router},
+		{"bgp-router-one", LS_PROTOCOL_BGP, 0, igp + "02040004c0000201"},
+		{"bgp-router-two", LS_PROTOCOL_BGP, 0, igp + "02040004c0000202"},
+		{"bgp-confed", LS_PROTOCOL_BGP, 0, igp + "02040004c0000201020500040000fde8"},
+		{"bgp-confed-zero", LS_PROTOCOL_BGP, 0, igp + "02040004c00002010205000400000000"},
+	}
+	seen := make(map[string]string)
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			node := malformedNodeUpdateForIdentityTest(t, tt.protocol, tt.instance, tt.descriptors, 1)
+			key := node.String()
+			if other, ok := seen[key]; ok {
+				t.Fatalf("malformed distinct node identities collide: %s and %s: %s", other, tt.name, key)
+			}
+			seen[key] = tt.name
+			if !strings.Contains(key, "DESC-JSON:") || !strings.Contains(key, "INVALID:") {
+				t.Fatal("malformed identity must retain descriptor JSON and invalid status")
+			}
+			for trailing := 1; trailing <= 3; trailing++ {
+				fresh := malformedNodeUpdateForIdentityTest(t, tt.protocol, tt.instance, tt.descriptors, trailing)
+				if fresh.String() != key {
+					t.Fatal("fresh malformed decode must retain the same supported descriptor identity")
+				}
+			}
+		})
+	}
+}
