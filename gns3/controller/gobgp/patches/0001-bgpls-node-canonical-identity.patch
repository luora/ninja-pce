+package table
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/osrg/gobgp/v3/pkg/packet/bgp"
+)
+
+func malformedOspfAreaUpdateForTest(t *testing.T, area uint32, withdraw bool) *bgp.BGPMessage {
+	t.Helper()
+	wire, err := ospfAreaNodeForTest(t, area).Serialize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire = append(wire, 0x2a)
+	binary.BigEndian.PutUint16(wire[2:4], uint16(len(wire)-4))
+	binary.BigEndian.PutUint16(wire[15:17], uint16(len(wire)-17))
+	var attrs []byte
+	if withdraw {
+		mp := append([]byte{0x40, 0x04, 0x47}, wire...)
+		attrs = append([]byte{0x80, 15, byte(len(mp))}, mp...)
+	} else {
+		mp := append([]byte{0x40, 0x04, 0x47, 4, 192, 0, 2, 2, 0}, wire...)
+		attrs = append([]byte{0x40, 1, 1, 0, 0x40, 2, 0, 0x80, 14, byte(len(mp))}, mp...)
+	}
+	body := append([]byte{0, 0, 0, 0}, attrs...)
+	binary.BigEndian.PutUint16(body[2:4], uint16(len(attrs)))
+	message := bytes.Repeat([]byte{0xff}, 19)
+	message[18] = bgp.BGP_MSG_UPDATE
+	binary.BigEndian.PutUint16(message[16:18], uint16(len(message)+len(body)))
+	message = append(message, body...)
+	decoded, err := bgp.ParseBGPMessage(message)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ok, err := bgp.ValidateUpdateMsg(decoded.Body.(*bgp.BGPUpdate), map[bgp.RouteFamily]bgp.BGPAddPathMode{bgp.RF_LS: bgp.BGP_ADD_PATH_NONE}, false, false, false); !ok {
+		t.Fatalf("upstream validator unexpectedly rejected fixture: %v", err)
+	}
+	return decoded
+}
+
+func TestLsNodeMalformedAreasSurviveIndependentWithdrawal(t *testing.T) {
+	tbl := NewTable(logger, bgp.RF_LS)
+	peer := &PeerInfo{AS: 65000, LocalAS: 65000, ID: net.ParseIP("192.0.2.2"), Address: net.ParseIP("192.0.2.2")}
+	apply := func(area uint32, withdraw bool) *Path {
+		t.Helper()
+		paths := ProcessMessage(malformedOspfAreaUpdateForTest(t, area, withdraw), peer, time.Now())
+		if len(paths) != 1 {
+			t.Fatalf("received update produced %d paths, want one", len(paths))
+		}
+		if _, err := paths[0].GetNlri().Serialize(); err == nil {
+			t.Fatal("fixture must use the serialization-error identity fallback")
+		}
+		tbl.update(paths[0])
+		return paths[0]
+	}
+	path0, path1 := apply(0, false), apply(1, false)
+	if got := len(tbl.GetDestinations()); got != 2 {
+		t.Fatalf("malformed two-area nodes must retain supported descriptor identity; got %d destinations", got)
+	}
+	replacement := apply(0, false)
+	if replacement.GetPrefix() != path0.GetPrefix() || len(tbl.GetDestinations()) != 2 || len(tbl.GetDestination(path0.GetNlri()).knownPathList) != 1 {
+		t.Fatal("fresh malformed same-area replacement changed destination identity")
+	}
+	withdraw := apply(0, true)
+	if withdraw.GetPrefix() != path0.GetPrefix() {
+		t.Fatal("independently decoded malformed withdrawal changed destination identity")
+	}
+	selected, err := tbl.Select()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(selected.GetDestinations()) != 1 || selected.GetDestination(path0.GetNlri()) != nil {
+		t.Fatal("malformed area-zero withdrawal did not remove only its active destination")
+	}
+	remaining := selected.GetDestination(path1.GetNlri())
+	if remaining == nil || len(remaining.knownPathList) != 1 || remaining.knownPathList[0] != path1 {
+		t.Fatal("malformed area-zero withdrawal changed the area-one path")
+	}
+}
