+package bgp
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/hex"
+	"testing"
+)
+
+func nodeIdentityTestPrefix(t *testing.T, protocol LsProtocolID, instance uint64, descriptors string) *LsAddrPrefix {
+	t.Helper()
+	desc, err := hex.DecodeString(descriptors)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire := make([]byte, 17+len(desc))
+	binary.BigEndian.PutUint16(wire[0:2], uint16(LS_NLRI_TYPE_NODE))
+	binary.BigEndian.PutUint16(wire[2:4], uint16(len(wire)-4))
+	wire[4] = byte(protocol)
+	binary.BigEndian.PutUint64(wire[5:13], instance)
+	binary.BigEndian.PutUint16(wire[13:15], uint16(LS_TLV_LOCAL_NODE_DESC))
+	binary.BigEndian.PutUint16(wire[15:17], uint16(len(desc)))
+	copy(wire[17:], desc)
+	node := &LsAddrPrefix{}
+	if err := node.DecodeFromBytes(wire); err != nil {
+		t.Fatal(err)
+	}
+	serialized, err := node.Serialize()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(wire, serialized) {
+		t.Fatalf("identity formatting must preserve wire NLRI: got %x, want %x", serialized, wire)
+	}
+	return node
+}
+
+func TestLsNodeCanonicalIdentity(t *testing.T) {
+	const igp = "020000040000fde80201000400000000"
+	const area0 = "0202000400000000"
+	const area1 = "0202000400000001"
+	const router = "02030004c0000201"
+	tests := []struct {
+		name        string
+		protocol    LsProtocolID
+		instance    uint64
+		descriptors string
+	}{
+		{"area-zero", LS_PROTOCOL_OSPF_V2, 0, igp + area0 + router},
+		{"area-one", LS_PROTOCOL_OSPF_V2, 0, igp + area1 + router},
+		{"area-absent", LS_PROTOCOL_OSPF_V2, 0, igp + router},
+		{"ls-id-absent", LS_PROTOCOL_OSPF_V2, 0, "020000040000fde8" + area0 + router},
+		{"instance", LS_PROTOCOL_OSPF_V2, 1, igp + area0 + router},
+		{"protocol", LS_PROTOCOL_OSPF_V3, 0, igp + area0 + router},
+		{"isis-l1", LS_PROTOCOL_ISIS_L1, 0, igp + "02030006000102030405"},
+		{"isis-l2", LS_PROTOCOL_ISIS_L2, 0, igp + "02030006000102030405"},
+		{"bgp-router-one", LS_PROTOCOL_BGP, 0, igp + "02040004c0000201"},
+		{"bgp-router-two", LS_PROTOCOL_BGP, 0, igp + "02040004c0000202"},
+		{"bgp-confed", LS_PROTOCOL_BGP, 0, igp + "02040004c0000201020500040000fde8"},
+		{"bgp-confed-zero", LS_PROTOCOL_BGP, 0, igp + "02040004c00002010205000400000000"},
+	}
+	seen := make(map[string]string)
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			node := nodeIdentityTestPrefix(t, tt.protocol, tt.instance, tt.descriptors)
+			key := node.String()
+			if other, ok := seen[key]; ok {
+				t.Fatalf("distinct node identities collide: %s and %s: %s", other, tt.name, key)
+			}
+			seen[key] = tt.name
+			node.SetPathIdentifier(123)
+			node.SetPathLocalIdentifier(456)
+			if node.String() != key {
+				t.Fatal("BGP path identifiers must not change destination identity")
+			}
+		})
+	}
+}
