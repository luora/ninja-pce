# Render ONLY ${DASHBOARD_HOST}; preserve every Nginx $variable below.
# Include inside each operator API location, under the existing authenticated
# HTTPS server. DASHBOARD_HOST is the exact netloc of provisioning.json.origin.
proxy_pass http://unix:/run/ninja-provisioning/http.sock;
proxy_http_version 1.1;
proxy_set_header Host ${DASHBOARD_HOST};
proxy_set_header Connection "";
proxy_set_header Authorization "";
proxy_set_header X-Ninja-Principal $remote_user;
# TunnelAPI authorizes the exact principal allowlist, not a caller role header.
proxy_set_header X-Ninja-Role "";
proxy_set_header Origin $http_origin;
proxy_set_header Cookie $http_cookie;
proxy_set_header X-CSRF-Token $http_x_csrf_token;
proxy_set_header Idempotency-Key $http_idempotency_key;
proxy_connect_timeout 3s;
proxy_read_timeout 15s;
proxy_send_timeout 15s;
proxy_request_buffering on;
proxy_buffering off;
proxy_next_upstream off;
proxy_cache off;
proxy_hide_header Cache-Control;
add_header Cache-Control "no-store" always;
