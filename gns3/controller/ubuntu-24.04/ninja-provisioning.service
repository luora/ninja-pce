[Unit]
Description=Ninja-PCE qualified dashboard RSVP provisioning API
After=network-online.target ninja-pcep.service ninja-bgpls.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/ninja-pce
EnvironmentFile=/etc/ninja-pce/provisioning.env
ExecStart=/home/ubuntu/ninja-pce/.venv/bin/python -m ninja_pce.cli_provisioning --config /etc/ninja-pce/provisioning.json
RuntimeDirectory=ninja-provisioning
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/ninja-pce/build/state

[Install]
WantedBy=multi-user.target
