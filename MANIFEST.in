include README.md pyproject.toml requirements.txt ninja-pce
recursive-include docs *.md
recursive-include deploy *.py *.json *.toml *.txt
recursive-include tools *.py *.sh
recursive-include examples *.json *.yml *.yaml
recursive-include tests *.py *.json *.hex *.txt *.md *.yml *.yaml
recursive-include src/ninja_pce/data *.proto
recursive-include src/ninja_pce/templates *.j2
recursive-include src/ninja_pce/web *.html *.css *.js
recursive-include gns3/controller *.md *.proto *.sh *.patch *.service *.template *.example *.json *.yaml *.toml *.txt *.conf
recursive-include gns3/router-configs *.md *.cfg *.set
recursive-include gns3/lab-data *.json *.yml *.yaml

prune .ninja-pce
