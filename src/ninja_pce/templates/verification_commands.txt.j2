# ninja-pce verification commands for {{ demand.name }}
# Selected path: {{ path_string }}

# Generic operator checks
show RSVP tunnel/LSP summary on {{ demand.source }}
show RSVP tunnel/LSP detail for {{ output.tunnel_name }}
show explicit route object / record route object for {{ output.tunnel_name }}
show RSVP interface bandwidth/reservations on selected links
show MPLS forwarding entry toward {{ dest_node.loopback }}
show service binding for the affected VPLS/VPWS/L3VPN
show interface utilization/errors on selected links

# IOS XR-style checks
show mpls traffic-eng tunnels {{ output.iosxr_interface }}
show mpls traffic-eng tunnels {{ output.iosxr_interface }} detail
show mpls traffic-eng topology path {{ source_node.loopback }} {{ dest_node.loopback }}
show rsvp interface
show rsvp session
show cef {{ dest_node.loopback }} detail

# Junos-style checks
run show mpls lsp name {{ output.junos_lsp_name }} extensive
run show mpls lsp ingress name {{ output.junos_lsp_name }}
run show rsvp session name {{ output.junos_lsp_name }} extensive
run show rsvp interface
run show route table inet.3 {{ dest_node.loopback }}

# Link-by-link check list
{% for link in result.path_links -%}
# {{ link.source }} -> {{ link.target }} via {{ link.id }}: expected reservation {{ demand.bandwidth_mbps }} Mbps; residual {{ link.available_bw_mbps - demand.bandwidth_mbps }} Mbps
{% endfor %}
